# 32 PHP workers: the same number of PHP processes, and therefore database
# connections, as the php-fpm pool and the Go pool. FrankenPHP requires the
# thread pool to be strictly larger than the worker count; the one extra thread
# would serve non-worker scripts, and every request here goes to the worker.
{
	auto_https off
	admin off
	frankenphp {
		num_threads 33
		worker {
			file /app/public/worker.php
			num 32
		}
	}
}

:80 {
	# Every request goes to the worker; no filesystem lookup on the way,
	# matching the php-fpm nginx config.
	route {
		rewrite * /worker.php
		root * /app/public
		php
	}
}
